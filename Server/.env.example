# Connect to Supabase Postgres via Transaction Pooler (Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Supabase Postgres via Session Pooler (Port 5432 - used for migrations & seeds)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

PORT=8000
NODE_ENV="development"
CLIENT_URL="http://localhost:5173"
JWT_SECRET="revora_super_secret_jwt_key_2026_change_in_prod"
JWT_EXPIRES_IN="7d"

